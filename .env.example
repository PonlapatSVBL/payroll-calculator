# MySQL Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# Salary month to process (YYYY-MM)
SALARY_MONTH=2026-05

# Concurrency settings
# MAX_CHANNELS_CONCURRENT  = how many channels run at the same time
# MAX_PEOPLE_PER_CHANNEL   = how many people per channel run at the same time
# Total concurrent API calls = MAX_CHANNELS_CONCURRENT * MAX_PEOPLE_PER_CHANNEL
MAX_CHANNELS_CONCURRENT=10
MAX_PEOPLE_PER_CHANNEL=10
